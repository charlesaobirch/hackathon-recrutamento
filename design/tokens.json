{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "TalentFlow · tokens do esboço de recrutamento. Fonte de verdade: tokens.css.",
  "primitive": {
    "color": {
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "ink": {
        "950": { "$value": "#0B1220", "$type": "color" },
        "900": { "$value": "#0F172A", "$type": "color" },
        "800": { "$value": "#1E293B", "$type": "color" }
      },
      "slate": {
        "700": { "$value": "#334155", "$type": "color" },
        "600": { "$value": "#475569", "$type": "color" },
        "500": { "$value": "#64748B", "$type": "color" },
        "400": { "$value": "#94A3B8", "$type": "color" },
        "300": { "$value": "#CBD5E1", "$type": "color" },
        "200": { "$value": "#E2E8F0", "$type": "color" },
        "100": { "$value": "#F1F5F9", "$type": "color" },
        "50": { "$value": "#F8FAFC", "$type": "color" }
      },
      "canvas": { "$value": "#F5F7FA", "$type": "color" },
      "blue": {
        "100": { "$value": "#DBEAFE", "$type": "color" },
        "600": { "$value": "#2563EB", "$type": "color" },
        "700": { "$value": "#1D4ED8", "$type": "color" }
      },
      "green": {
        "100": { "$value": "#DCFCE7", "$type": "color" },
        "700": { "$value": "#15803D", "$type": "color" },
        "800": { "$value": "#166534", "$type": "color" }
      },
      "amber": {
        "100": { "$value": "#FEF3C7", "$type": "color" },
        "700": { "$value": "#B45309", "$type": "color" },
        "800": { "$value": "#92400E", "$type": "color" }
      },
      "red": {
        "100": { "$value": "#FEE2E2", "$type": "color" },
        "200": { "$value": "#FECACA", "$type": "color" },
        "700": { "$value": "#B91C1C", "$type": "color" },
        "800": { "$value": "#991B1B", "$type": "color" }
      },
      "violet": {
        "100": { "$value": "#EDE9FE", "$type": "color" },
        "700": { "$value": "#6D28D9", "$type": "color" }
      }
    },
    "space": {
      "1": { "$value": "4px", "$type": "dimension" },
      "2": { "$value": "8px", "$type": "dimension" },
      "3": { "$value": "12px", "$type": "dimension" },
      "4": { "$value": "16px", "$type": "dimension" },
      "5": { "$value": "20px", "$type": "dimension" },
      "6": { "$value": "24px", "$type": "dimension" },
      "8": { "$value": "32px", "$type": "dimension" },
      "10": { "$value": "40px", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "8px", "$type": "dimension" },
      "md": { "$value": "10px", "$type": "dimension" },
      "lg": { "$value": "14px", "$type": "dimension" },
      "xl": { "$value": "18px", "$type": "dimension" },
      "pill": { "$value": "999px", "$type": "dimension" }
    },
    "font": {
      "family": { "$value": "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif", "$type": "fontFamily" },
      "size": {
        "2xs": { "$value": "10px", "$type": "dimension" },
        "xs": { "$value": "11px", "$type": "dimension" },
        "sm": { "$value": "12px", "$type": "dimension" },
        "base": { "$value": "13px", "$type": "dimension" },
        "md": { "$value": "14px", "$type": "dimension" },
        "lg": { "$value": "18px", "$type": "dimension" },
        "xl": { "$value": "24px", "$type": "dimension" },
        "2xl": { "$value": "28px", "$type": "dimension" },
        "3xl": { "$value": "40px", "$type": "dimension" }
      }
    }
  },
  "semantic": {
    "surface": {
      "canvas": { "$value": "{primitive.color.canvas}", "$type": "color" },
      "default": { "$value": "{primitive.color.white}", "$type": "color" },
      "subtle": { "$value": "{primitive.color.slate.50}", "$type": "color" },
      "muted": { "$value": "{primitive.color.slate.100}", "$type": "color" },
      "inverse": { "$value": "{primitive.color.ink.950}", "$type": "color" },
      "inverseRaised": { "$value": "#111C2E", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "{primitive.color.ink.900}", "$type": "color" },
      "secondary": { "$value": "{primitive.color.slate.600}", "$type": "color" },
      "muted": { "$value": "{primitive.color.slate.500}", "$type": "color" },
      "onInverse": { "$value": "{primitive.color.white}", "$type": "color" },
      "onInverseMuted": { "$value": "{primitive.color.slate.400}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{primitive.color.slate.200}", "$type": "color" },
      "strong": { "$value": "{primitive.color.slate.300}", "$type": "color" },
      "inverse": { "$value": "{primitive.color.ink.800}", "$type": "color" }
    },
    "status": {
      "accent": { "$value": "{primitive.color.blue.600}", "$type": "color" },
      "accentHover": { "$value": "{primitive.color.blue.700}", "$type": "color" },
      "accentSoft": { "$value": "{primitive.color.blue.100}", "$type": "color" },
      "success": { "$value": "{primitive.color.green.700}", "$type": "color" },
      "successSoft": { "$value": "{primitive.color.green.100}", "$type": "color" },
      "warning": { "$value": "{primitive.color.amber.700}", "$type": "color" },
      "warningSoft": { "$value": "{primitive.color.amber.100}", "$type": "color" },
      "danger": { "$value": "{primitive.color.red.700}", "$type": "color" },
      "dangerSoft": { "$value": "{primitive.color.red.100}", "$type": "color" },
      "violet": { "$value": "{primitive.color.violet.700}", "$type": "color" },
      "violetSoft": { "$value": "{primitive.color.violet.100}", "$type": "color" }
    }
  },
  "component": {
    "button": {
      "height": { "$value": "38px", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.sm}", "$type": "dimension" },
      "primaryBg": { "$value": "{semantic.status.accent}", "$type": "color" },
      "primaryBgHover": { "$value": "{semantic.status.accentHover}", "$type": "color" },
      "primaryFg": { "$value": "{primitive.color.white}", "$type": "color" },
      "ghostBg": { "$value": "{semantic.surface.default}", "$type": "color" },
      "ghostBorder": { "$value": "{semantic.border.default}", "$type": "color" }
    },
    "badge": {
      "height": { "$value": "22px", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.pill}", "$type": "dimension" }
    },
    "table": {
      "rowHeight": { "$value": "54px", "$type": "dimension" },
      "headerBg": { "$value": "{semantic.surface.subtle}", "$type": "color" },
      "headerFg": { "$value": "{semantic.text.secondary}", "$type": "color" },
      "border": { "$value": "{semantic.border.default}", "$type": "color" }
    },
    "nav": {
      "itemHeight": { "$value": "40px", "$type": "dimension" },
      "itemRadius": { "$value": "{primitive.radius.md}", "$type": "dimension" },
      "fg": { "$value": "{primitive.color.slate.400}", "$type": "color" },
      "fgActive": { "$value": "{primitive.color.white}", "$type": "color" },
      "bgActive": { "$value": "{primitive.color.ink.800}", "$type": "color" }
    }
  }
}
